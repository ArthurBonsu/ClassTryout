{
  "name": "crosschain-passchain",
  "version": "1.0.0",
  "description": "Cross-chain transaction system with Passchain implementation",
  "main": "truffle-config.js",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "truffle test",
    "compile": "truffle compile",
    "migrate": "truffle migrate",
    "measure": "node scripts/measure_performance.js",
    "deploy:ethereum": "node scripts/deploy_ethereum.js",
    "deploy:polkadot": "node scripts/deploy_polkadot.js",
    "deploy:tatum": "node scripts/deploy_ethereum.js",
    "deploy:tatum:test": "truffle migrate --network tatum_testnet",
    "verify": "node scripts/verify-contracts.js",
    "analyze": "ANALYZE=true next build",
    "run:workflow": "python python/blockchainworkflow.py",
    "climate:test": "node --no-deprecation test/run-climate-regulation-experiment.js",
    "climate:continue": "node --no-deprecation test/run-climate-regulation-experiment.js --continue",
    "climate:summary": "node --no-deprecation test/run-climate-regulation-experiment.js --summary",
    "passchain:benchmark": "node test/benchmark.js",
    "passchain:comprehensive": "node test/benchmark.js comprehensive",
    "passchain:test": "node test/passchain-enhanced-multichain.js",
    "passchain:simulation": "node passchain_story_test.js",
    "cloud:start": "node passchain_cloud/passchain_cloud_service.js",
    "cloud:dev": "nodemon passchain_cloud/passchain_cloud_service.js",
    "cloud:test": "node passchain_cloud/passchain_cloud_validator.js",
    "cloud:deploy": "./passchain_cloud/cloud_deployment_orchestrator.sh",
    "cloud:local-test": "./passchain_cloud/local_test.sh",
    "cloud:logs": "gcloud run logs tail passchain-cloud-service --region=us-central1"
  },
  "overrides": {
    "whatwg-url": "^11.0.0"
  },
  "dependencies": {
     "@google-cloud/storage": "^7.17.3",
    "@chainlink/contracts": "0.8",
    "@cosmjs/cosmwasm-stargate": "^0.31.0",
    "@cosmjs/proto-signing": "^0.31.0",
    "@openzeppelin/contracts": "^4.9.3",
    "@polkadot/api": "^10.9.1",
    "@polkadot/util-crypto": "^12.0.0",
    "@truffle/hdwallet-provider": "^2.1.15",
    "@uniswap/v2-periphery": "1.1.0-beta.0",
    "@web3-react/core": "^8.2.3",
    "@web3-react/injected-connector": "^6.0.7",
    "axios": "1.6.0",
    "browserify-zlib": "^0.2.0",
    "crypto-browserify": "^3.12.1",
    "csv-parse": "^5.5.2",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.5.0",
    "ethers": "^6.9.0",
    "fastapi": "^0.0.8",
    "flask": "^0.2.10",
    "html2canvas": "^1.4.1",
    "https-browserify": "^1.0.0",
    "moment": "^2.29.4",
    "next": "14.0.4",
    "numpy": "^0.0.1",
    "os-browserify": "^0.3.0",
    "pandas": "^0.0.3",
    "puppeteer": "^24.6.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "recharts": "^3.1.0",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "truffle-hdwallet-provider": "^1.0.17",
    "web3": "^4.16.0",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "winston": "^3.11.0",
    "chartjs-node-canvas": "^4.1.6",
    "chart.js": "^4.4.0",
    "simple-statistics": "^7.8.3",
    "plotly": "^1.0.6",
    "canvas": "^2.11.2",
    "jspdf": "^2.5.1",
    "sharp": "^0.32.6"
  },
  "devDependencies": {

    "@next/bundle-analyzer": "^14.0.4",
    "@parity/hardhat-polkadot": "^0.1.9",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.0",
    "@types/web3": "^1.2.2",
    "chai": "^5.1.2",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.0.4",
    "ganache-cli": "^6.12.2",
    "jest": "^29.7.0",
    "mocha": "^11.0.1",
    "solc": "^0.8.28",
    "truffle": "^5.11.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "nodemon": "^3.0.2"
  }
}